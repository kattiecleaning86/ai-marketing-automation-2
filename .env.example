# Copy to .env for local use. On a hosting provider, set these as environment variables instead.
# Never commit a real .env file.

# Required: password for the admin dashboard (username: admin)
ADMIN_PASSWORD=change-me
# The public address of the app (used in Slack links and the Google redirect URI)
BASE_URL=http://localhost:8000

# Claude API key (or paste it on the Settings page instead)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Optional (can also be entered on the Settings page)
SLACK_WEBHOOK_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Safety limits
AUTO_START_RUNS=true
MAX_RUNS_PER_DAY=10
MAX_POSTS_PER_MONTH=40

# Where the database and deliverables are stored
DATA_DIR=./data
